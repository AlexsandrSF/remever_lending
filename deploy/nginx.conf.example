# Example: landing under https://remever.ru/landing/
location /landing/ {
    proxy_pass http://127.0.0.1:5001/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Prefix /landing;
}
# Static files straight from disk (long cache, files are not fingerprinted: bump on change)
location /landing/static/ {
    alias /srv/remever_landing/static/;
    expires 7d;
    add_header Cache-Control "public";
}
# gzip: text/css, application/javascript, image/svg+xml, text/html
# HSTS belongs to the server block: add_header Strict-Transport-Security "max-age=31536000" always;
