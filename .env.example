# Copy to .env (never commit .env). Everything is optional for local development.
SITE_URL=https://remever.ru/landing      # public URL of the landing (canonical, sitemap, og:image)
YM_ID=                                   # Yandex Metrika counter id (digits). Empty = no analytics, no cookie banner
RUSTORE_URL=                             # until set, the buttons are inert ("#")
APP_URL=                                 # PWA / "Start now" link
VK_URL=
TG_URL=
MAX_URL=
TRUST_PROXY=1                            # behind nginx: take scheme/host/prefix from X-Forwarded-* headers

# Operator details for the privacy and cookie pages (placeholders stay highlighted until filled)
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_REG=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
LEGAL_LEGAL_DATE=
LEGAL_LOG_RETENTION=
